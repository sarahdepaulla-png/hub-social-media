# Preenchido automaticamente pelo `npx convex dev` em .env.local
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# As variáveis abaixo ficam no Convex (npx convex env set NOME valor), não aqui:
# ADMIN_EMAILS       e-mails de admin, separados por vírgula
# AUTH_RESEND_KEY    chave do Resend para enviar o código por e-mail
# AUTH_EMAIL_FROM    remetente, ex.: Hub Social Media <acesso@seudominio.com.br>
# SITE_URL, JWT_PRIVATE_KEY, JWKS   criadas pelo `npx @convex-dev/auth`
